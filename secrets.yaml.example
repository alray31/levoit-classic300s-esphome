# Copy this file to secrets.yaml (same folder) and fill in your own values.
# secrets.yaml is gitignored -- never commit real credentials.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Generate with: esphome wizard, or `python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"`
# Also secures OTA updates -- ota: reuses this same key instead of a
# separate password.
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

ap_password: "REPLACE_WITH_A_PASSWORD"
